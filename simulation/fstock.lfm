object StockForm: TStockForm
  Left = 400
  Height = 400
  Top = 200
  Width = 600
  BorderStyle = bsDialog
  Caption = 'Supplier Warung (Grosir)'
  ClientHeight = 400
  ClientWidth = 600
  OnShow = FormShow
  Position = poMainFormCenter
  LCLVersion = '3.0.0.0'
  object sgProducts: TStringGrid
    Left = 0
    Height = 350
    Top = 0
    Width = 600
    Align = alClient
    FixedCols = 0
    Options = [goFixedVertLine, goFixedHorzLine, goVertLine, goHorzLine, goRangeSelect, goRowSelect, goSmoothScroll]
    TabOrder = 0
  end
  object pnlBottom: TPanel
    Left = 0
    Height = 50
    Top = 350
    Width = 600
    Align = alBottom
    BevelOuter = bvNone
    ClientHeight = 50
    ClientWidth = 600
    TabOrder = 1
    object lblCash: TLabel
      Left = 16
      Height = 15
      Top = 16
      Width = 117
      Caption = 'Sisa Kas Uang: Rp 0'
      Font.Style = [fsBold]
      ParentFont = False
    end
    object btnBuy: TButton
      Left = 384
      Height = 30
      Top = 10
      Width = 100
      Caption = 'Beli (10 Pcs)'
      Font.Style = [fsBold]
      OnClick = btnBuyClick
      ParentFont = False
      TabOrder = 0
    end
    object btnClose: TButton
      Left = 496
      Height = 30
      Top = 10
      Width = 88
      Caption = 'Tutup'
      OnClick = btnCloseClick
      TabOrder = 1
    end
  end
end
